# Create a free account at https://www.themoviedb.org/settings/api
# Paste either the v3 API key...
VITE_TMDB_API_KEY=

# ...or the v4 read access token. One of the two is enough.
VITE_TMDB_READ_TOKEN=

# Optional. Point the client at a proxy or a local mock. Defaults shown.
# VITE_TMDB_API_BASE_URL=https://api.themoviedb.org/3
# VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
